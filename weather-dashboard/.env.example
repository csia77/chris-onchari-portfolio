# ============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION GUIDE
# ----------------------------------------------------------------------------
# The project currently uses Open-Meteo REST API out-of-the-box, which does
# NOT require an API key. 
# 
# If you wish to switch to OpenWeatherMap REST API, rename this file to .env
# and add your free OpenWeatherMap API Key below:
# ============================================================================

VITE_WEATHER_API_PROVIDER=open-meteo
# VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
